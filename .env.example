# Скопируйте в .env и впишите свой ключ ProxyAPI
PROXY_API_KEY=
# Провайдер модели: openai (для ДЗ) или anthropic (для боевого проекта LP)
LLM_PROVIDER=openai
# OpenAI через ProxyAPI. Точное имя модели сверить скриптом scripts/list_models.py
OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1
OPENAI_MODEL=gpt-4.1-mini
# Температура (работает у OpenAI; у claude-sonnet-5-5 параметра нет)
LLM_TEMPERATURE=0.2
# Claude через ProxyAPI
PROXY_API_BASE_URL=https://api.proxyapi.ru/anthropic
CLAUDE_MODEL=claude-sonnet-5-5
# Лимит запросов в минуту на один client_id
RATE_LIMIT_PER_MINUTE=5
# База: SQLite для ДЗ, для боевого проекта - строка PostgreSQL
DATABASE_URL=sqlite:///./triage.db
# Какие сайты могут вызывать API из браузера (через запятую); пусто = никакие
CORS_ORIGINS=
